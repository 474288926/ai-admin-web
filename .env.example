# 前端调用后端的 API 路径。使用 Docker Compose 的 Nginx 反向代理时保持 /api/v1 即可。
VITE_API_BASE_URL=/api/v1
# 局域网邀请链接的公开前端地址；请改为运行本机当前局域网 IPv4。
VITE_PUBLIC_APP_ORIGIN=http://192.168.30.122:5173
# 允许嵌入客服知识面板并通过 postMessage 交换工单上下文的工作台 Origin，逗号分隔。
# 生产环境必须填写精确 https Origin，不支持通配符。
VITE_SUPPORT_WORKBENCH_ORIGINS=http://localhost:5173,http://192.168.30.122:5173
# 工单系统的新建页地址。只允许 HTTPS；本机联调可使用 localhost HTTP。
# 知识助手不会在 URL 中拼接客户问题，也不会自动提交工单。
VITE_TICKET_SYSTEM_CREATE_URL=
